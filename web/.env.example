# Web の環境変数の一覧(値は書かない)。ローカルは web/.env.local、本番はリポジトリの外のファイルに設定する(docs/setup.md)。
# 読み込み口は src/lib/env.ts。変数を足したら、ここにも足すこと。

# ---- Supabase(必須)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側が内部で直接接続するURL(任意。未設定時は NEXT_PUBLIC_SUPABASE_URL)
INTERNAL_SUPABASE_URL=
# 秘密情報。RLS を素通りする
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudflare R2(APK の保存先。必須)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- APK検査(GitHub Actions)
# 検査結果の通知の署名に使う共有シークレット(GitHub の Secrets と同じ値。必須)
SCAN_WEBHOOK_SECRET=
# 検査ワークフローを起動するトークンと owner/repo。未設定なら自動では起動しない
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=

# ---- その他
# ダウンロード数の重複判定に使う端末IDのハッシュ用ソルト(必須)
DEVICE_HASH_SALT=
# DB(pg_net)から /api/internal/notify を呼ぶときの共有シークレット(必須)
NOTIFY_WEBHOOK_SECRET=
# ストアアプリ自身のパッケージ名(既定: com.kawamonn.store)
STORE_PACKAGE_NAME=
# サイトのURL(既定: https://store.kawamonn.com)。ビルド時に埋め込まれる
NEXT_PUBLIC_SITE_URL=

# ---- 運営へのメール通知(Resend)。未設定なら送らない
RESEND_API_KEY=
ADMIN_NOTIFY_EMAIL=
# 差出人(既定: Resend の onboarding@resend.dev)
MAIL_FROM=

# ---- 手元で使うスクリプト用(サーバーには不要)
# scripts/publish-app.mjs: アプリを登録する管理者のユーザーID
ADMIN_USER_ID=
# scripts/deploy-web.ps1: 接続先(user@host)と、サーバー上のリポジトリの場所
DEPLOY_SSH=
DEPLOY_DIR=
